# Copy this to .env in each service folder

# Auth Service (.env)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_db"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
PORT=3001

# Catalog Service (.env)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/catalog_db"
PORT=3002

# Order Service (.env)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/order_db"
INVENTORY_SERVICE_URL="http://localhost:3004"
PORT=3003

# Inventory Service (.env)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory_db"
PORT=3004

# API Gateway (.env)
AUTH_SERVICE_URL="http://localhost:3001"
CATALOG_SERVICE_URL="http://localhost:3002"
ORDER_SERVICE_URL="http://localhost:3003"
INVENTORY_SERVICE_URL="http://localhost:3004"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
PORT=3000
